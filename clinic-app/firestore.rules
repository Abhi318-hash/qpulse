rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Super-admin: only the account with role='super_admin' in /admins/{phone}
    // This is the highest privilege — only you have this.
    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.phone_number)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.phone_number)).data.role == 'super_admin' &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.phone_number)).data.is_active == true;
    }

    // Org Admin: has role='org_admin' and belongs to an org
    function isOrgAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.phone_number)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.phone_number)).data.role == 'org_admin' &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.phone_number)).data.is_active == true;
    }

    // Get the org_id of the current org admin
    function getCallerOrgId() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.phone_number)).data.org_id;
    }

    // Clinic staff: their phone matches authorized_phone on the clinic doc
    function isClinicStaff(clinicId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clinics/$(clinicId)) &&
        get(/databases/$(database)/documents/clinics/$(clinicId)).data.authorized_phone
          == request.auth.token.phone_number;
    }

    // Check if caller owns the patient document (primary or recovery)
    function isPatientOwner(patientId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/patients/$(patientId)) &&
        (get(/databases/$(database)/documents/patients/$(patientId)).data.phone == request.auth.token.phone_number ||
         get(/databases/$(database)/documents/patients/$(patientId)).data.recovery_phone == request.auth.token.phone_number);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ADMINS COLLECTION
    // Only super-admin can read/write the admin list
    // ─────────────────────────────────────────────────────────────────────────
    match /admins/{adminPhone} {
      allow read:   if isSuperAdmin() || request.auth.token.phone_number == adminPhone;
      allow create: if isSuperAdmin(); // Only super admin grants access
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ORG REQUESTS — New Collection
    // Incoming application forms from clinics/hospitals wanting to join.
    // Anyone authenticated can submit; only super admin can read and action.
    // ─────────────────────────────────────────────────────────────────────────
    match /org_requests/{requestId} {
      allow read:   if isSuperAdmin() ||
                       (isSignedIn() && resource.data.contact_phone == request.auth.token.phone_number);
      allow create: if isSignedIn(); // Any authenticated user can submit an application
      allow update: if isSuperAdmin(); // Only super admin approves/rejects
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ORGANIZATIONS
    // Created ONLY via Cloud Function (approval workflow), never client-side.
    // ─────────────────────────────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read:   if isSignedIn() &&
                       (resource.data.owner_uid == request.auth.uid || isSuperAdmin() || isOrgAdmin());
      allow create: if false; // Cloud Function only — super admin approval flow creates these
      allow update: if isSignedIn() &&
                       (resource.data.owner_uid == request.auth.uid || isSuperAdmin());
      allow delete: if false; // Cloud Function only — hardDeleteOrganization handles this
    }

    // ─────────────────────────────────────────────────────────────────────────
    // HOSPITALS — New Collection (Optional tier between Org and Clinics)
    // ─────────────────────────────────────────────────────────────────────────
    match /hospitals/{hospitalId} {
      allow read:   if true; // Public can search hospitals
      allow create: if isSuperAdmin() ||
                       (isOrgAdmin() && request.resource.data.org_id == getCallerOrgId());
      allow update: if isSuperAdmin() ||
                       (isOrgAdmin() && resource.data.org_id == getCallerOrgId());
      allow delete: if false; // Cloud Function only — cascade delete
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CLINICS
    // Public read; org admin or super admin can create; only super admin hard-deletes.
    // ─────────────────────────────────────────────────────────────────────────
    match /clinics/{clinicId} {
      allow read:   if true; // Public can search clinics
      allow create: if isSuperAdmin() ||
                       (isOrgAdmin() && request.resource.data.org_id == getCallerOrgId());
      allow update: if isSuperAdmin() ||
                       isClinicStaff(clinicId) ||
                       (isOrgAdmin() && resource.data.org_id == getCallerOrgId());
      allow delete: if false; // Cloud Function only
    }

    // ─────────────────────────────────────────────────────────────────────────
    // APPOINTMENTS
    // ─────────────────────────────────────────────────────────────────────────
    match /appointments/{apptId} {
      allow read: if isSignedIn() && (
        resource.data.user_phone == request.auth.token.phone_number ||
        isClinicStaff(resource.data.clinic_id) ||
        isSuperAdmin() ||
        isOrgAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.user_phone == request.auth.token.phone_number ||
        isClinicStaff(request.resource.data.clinic_id) ||
        isSuperAdmin()
      );
      allow update: if isSignedIn() && (
        isClinicStaff(resource.data.clinic_id) ||
        (resource.data.user_phone == request.auth.token.phone_number &&
         request.resource.data.status == 'CANCELLED') ||
        isSuperAdmin()
      );
      allow delete: if false; // Cloud Function only
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PATIENTS + SUB-COLLECTIONS
    // ─────────────────────────────────────────────────────────────────────────
    match /patients/{patientId} {
      allow get:   if isSignedIn() && (
        request.auth.uid == patientId || isPatientOwner(patientId) || isSuperAdmin()
      );
      allow list:  if isSignedIn() && (
        resource.data.phone == request.auth.token.phone_number ||
        resource.data.recovery_phone == request.auth.token.phone_number ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && request.auth.uid == patientId;
      allow update: if isSignedIn() && (
        request.auth.uid == patientId || isPatientOwner(patientId) || isSuperAdmin()
      );
      allow delete: if isSuperAdmin();

      match /medical_records/{recordId} {
        allow read:          if isSignedIn() && (
          isPatientOwner(patientId) ||
          isClinicStaff(resource.data.clinic_id) ||
          isSuperAdmin()
        );
        allow create, update: if isSignedIn() && (
          isClinicStaff(request.resource.data.clinic_id) || isSuperAdmin()
        );
        allow delete: if isSuperAdmin();
      }

      match /prescriptions/{prescriptionId} {
        allow read:   if isSignedIn() && (
          isPatientOwner(patientId) ||
          isClinicStaff(resource.data.clinic_id) ||
          isSuperAdmin()
        );
        allow create: if isSignedIn();
        allow delete: if isSignedIn() && (
          isPatientOwner(patientId) || isSuperAdmin()
        );
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // SYSTEM AUDIT LOGS — Append-only, immutable
    // All actions by admins, staff, and doctors are audited.
    // ─────────────────────────────────────────────────────────────────────────
    match /system_audits/{logId} {
      allow read:   if isSuperAdmin() || isOrgAdmin();
      allow create: if isSignedIn(); // Any auth user can write a log (staff, doctor, admin)
      allow update: if false;        // IMMUTABLE — no edits ever
      allow delete: if false;        // IMMUTABLE — no deletes ever
    }

    // ─────────────────────────────────────────────────────────────────────────
    // FCM TOKENS
    // ─────────────────────────────────────────────────────────────────────────
    match /fcm_tokens/{phone} {
      allow read, write: if isSignedIn() && request.auth.token.phone_number == phone;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // NOTIFICATION QUEUE — Cloud Functions write only
    // ─────────────────────────────────────────────────────────────────────────
    match /notifications_queue/{jobId} {
      allow read:  if isSuperAdmin();
      allow write: if false; // Only Cloud Functions (Admin SDK)
    }

    // ─────────────────────────────────────────────────────────────────────────
    // SUBSCRIPTIONS
    // ─────────────────────────────────────────────────────────────────────────
    match /subscriptions/{orgId} {
      allow read:   if isSignedIn() &&
        (get(/databases/$(database)/documents/organizations/$(orgId)).data.owner_uid
          == request.auth.uid || isSuperAdmin());
      allow write:  if isSuperAdmin();
    }

  }
}
