rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Doctor profile photos — public read, any auth user can write ──────────
    match /clinics/{clinicId}/doctor_photo/{filename} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024   // 5 MB max
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Patient prescriptions — private, patient-only write ──────────────────
    // Read: authenticated (patient can view their own; staff needs patient to share URL)
    match /prescriptions/{patientId}/{filename} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && request.resource.size < 20 * 1024 * 1024  // 20 MB max
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }

    // ── Lab reports — patients or staff can upload, auth required to read ─────
    match /lab_reports/{patientId}/{filename} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && request.resource.size < 50 * 1024 * 1024; // 50 MB max
      allow delete: if request.auth != null;
    }

    // ── Everything else — deny by default ────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
